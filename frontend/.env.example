VITE_SEPOLIA_RPC_URL=

# Arşiv RPC uç noktası — ESKİ tx'lerin RECEIPT'ini servis eden bir düğüm.
# NE İŞE YARAR: `send-transaction-test.mjs`'in canlı Sepolia oracle'ı ve
# docs/evidence/ altındaki tx kanıtlarının yeniden doğrulanması bunu kullanır.
# PUBLIC ENDPOINT NEDEN YETMİYOR: public sağlayıcılar (publicnode dahil) Sepolia
# receipt'lerini ~8.000-10.000 blok (≈30 saat) sonra buduyor —
# eth_getTransactionByHash tx'i vermeye devam ederken eth_getTransactionReceipt
# null dönüyor, yani kanıt tx'leri o endpoint'ten DOĞRULANAMIYOR. Ölçüm:
# docs/evidence/crypto-tests/sprint4-screen-consistency.md § 7.1
# ANAHTARSIZ ÇALIŞAN (15 Eylül 2026'da ölçüldü): https://sepolia.gateway.tenderly.co
# Anahtarlı alternatifler: Alchemy / Infura ücretsiz katman.
VITE_SEPOLIA_ARCHIVE_RPC_URL=
